        "schedule_callback": {
          "approved_at": "2026-10-19T03:27:05+00:00",
          "approved_by": "Sumanth",
          "definition": {
            "annotations": {
              "destructiveHint": false,
              "idempotentHint": true,
              "openWorldHint": false,
              "readOnlyHint": false
            },
            "description": "Books a callback to the member in their preferred date and time window and returns the booking. Use when a member asks to be phoned back at a convenient time.",
            "inputSchema": {
              "additionalProperties": false,
              "properties": {
                "idempotency_key": {
                  "description": "Client-generated UUID; retrying with the same key replays the original result",
                  "format": "uuid",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
                  "title": "Idempotency Key",
                  "type": "string"
                },
                "member_id": {
                  "description": "Member ID, e.g. M-000123",
                  "pattern": "^M-\\d{6}$",
                  "title": "Member Id",
                  "type": "string"
                },
                "preferred_date": {
                  "description": "ISO 8601 date (YYYY-MM-DD), from today up to 30 days ahead",
                  "format": "date",
                  "title": "Preferred Date",
                  "type": "string"
                },
                "preferred_window": {
                  "enum": [
                    "morning",
                    "afternoon"
                  ],
                  "title": "Preferred Window",
                  "type": "string"
                },
                "reason": {
                  "enum": [
                    "claim_query",
                    "payment_query",
                    "policy_query",
                    "complaint"
                  ],
                  "title": "Reason",
                  "type": "string"
                }
              },
              "required": [
                "member_id",
                "reason",
                "preferred_date",
                "preferred_window",
                "idempotency_key"
              ],
              "title": "schedule_callbackArguments",
              "type": "object"
            },
            "name": "schedule_callback",
            "outputSchema": {
              "properties": {
                "callback_id": {
                  "title": "Callback Id",
                  "type": "integer"
                },
                "preferred_date": {
                  "format": "date",
                  "title": "Preferred Date",
                  "type": "string"
                },
                "preferred_window": {
                  "enum": [
                    "morning",
                    "afternoon"
                  ],
                  "title": "Preferred Window",
                  "type": "string"
                }
              },
              "required": [
                "callback_id",
                "preferred_date",
                "preferred_window"
              ],
              "title": "CallbackScheduled",
              "type": "object"
            }
          },
          "hash": "sha256:ac4155a99cd65de411e5170aabbceabf434852680fd9d51186dda4cf3f513ed2",
          "override_reason": null,
          "scan": {
            "rule_ids": [],
            "tiers": [
              "rules"
            ],
            "verdict": "benign"
          }
        },
        "send_member_message": {
          "approved_at": "2026-10-19T03:27:05+00:00",
          "approved_by": "Sumanth",
          "definition": {
            "annotations": {
              "destructiveHint": false,
              "idempotentHint": true,
              "openWorldHint": false,
              "readOnlyHint": false
            },
            "description": "Sends a pre-approved template message to the member's contact on file and returns a correspondence ID. Use when a member needs a standard notification such as a claim update or a request for documents.",
            "inputSchema": {
              "additionalProperties": false,
              "properties": {
                "claim_id": {
                  "anyOf": [
                    {
                      "description": "Claim ID, e.g. C-000123",
                      "pattern": "^C-\\d{6}$",
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "default": null,
                  "description": "Required for claim_status_update, payment_confirmation and documents_required",
                  "title": "Claim Id"
                },
                "idempotency_key": {
                  "description": "Client-generated UUID; retrying with the same key replays the original result",
                  "format": "uuid",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
                  "title": "Idempotency Key",
                  "type": "string"
                },
                "member_id": {
                  "description": "Member ID, e.g. M-000123",
                  "pattern": "^M-\\d{6}$",
                  "title": "Member Id",
                  "type": "string"
                },
                "template_id": {
                  "enum": [
                    "claim_status_update",
                    "payment_confirmation",
                    "documents_required",
                    "callback_confirmation",
                    "policy_renewal_reminder"
                  ],
                  "title": "Template Id",
                  "type": "string"
                }
              },
              "required": [
                "member_id",
                "template_id",
                "idempotency_key"
              ],
              "title": "send_member_messageArguments",
              "type": "object"
            },
            "name": "send_member_message",
            "outputSchema": {
              "description": "Delivery receipt. The recipient is deliberately omitted.",
              "properties": {
                "channel": {
                  "enum": [
                    "email",
                    "sms",
                    "post",
                    "phone"
                  ],
                  "title": "Channel",
                  "type": "string"
                },
                "correspondence_id": {
                  "title": "Correspondence Id",
                  "type": "integer"
                },
                "sent_at": {
                  "format": "date-time",
                  "title": "Sent At",
                  "type": "string"
                }
              },
              "required": [
                "correspondence_id",
                "channel",
                "sent_at"
              ],
              "title": "MessageSent",
              "type": "object"
            }
          },
          "hash": "sha256:654137e7a88fd5f84204b4ca2bde930b2d138e7cb32825f69c6fa5fe02745589",
          "override_reason": null,
          "scan": {
            "rule_ids": [],
